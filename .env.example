[TEMPLATE]
# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------- Supabase
# Phase 4: Supabase Auth is the account provider when all three server values
# below are present. The encrypted journal remains local. If they are absent,
# the server keeps the pre-migration JSON account path for development only.
#
# Browser-visible values kept from the database phase. Phase 4 does not read
# Supabase directly from the browser, so these are optional. Use the
# publishable/anon key only, never the service role key.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_PUBLISHABLE_OR_ANON_KEY"

# Server-only. Never prefix these with VITE_, expose them to the browser, or
# commit real values. The service role bypasses RLS and is equivalent to full
# database access.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY_SERVER_ONLY"
# Used only to call Supabase Auth's /auth/v1/user endpoint during admin token
# verification. This is still a server-only value; do not expose it as VITE_.
SUPABASE_ANON_KEY="YOUR_PUBLISHABLE_OR_ANON_KEY"
# Phase 4 rollout switch. Leave false while connecting and testing the project.
# Set true only when you are ready to switch registration/login to Supabase.
SUPABASE_AUTH_ENABLED="false"
SUPABASE_JWKS_URL="https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json"
SUPABASE_JWT_ISSUER="https://YOUR_PROJECT_REF.supabase.co/auth/v1"
SUPABASE_JWT_AUDIENCE="authenticated"

# Migration-only credentials. Use a direct or session-pooled Postgres URL, not
# a client key. Keep SUPABASE_ACCESS_TOKEN out of the application runtime.
SUPABASE_DB_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"
SUPABASE_DB_PASSWORD="YOUR_DB_PASSWORD"
SUPABASE_ACCESS_TOKEN="YOUR_SUPABASE_ACCESS_TOKEN"

# Exact production origin used by Supabase email verification/reset redirects.
# Add `APP_ORIGIN/api/auth/callback` to the Supabase redirect allow list.
APP_ORIGIN="https://YOUR_APP_ORIGIN"

# ---------------------------------------------------------------- AI assistant
# Keys live in .env in the project root (gitignored) or in the host's secret
# settings. The server loads .env at startup; real environment variables win.
# The assistant needs one provider key. Keys are read on the server only and
# are never sent to the browser. With no key set the app still works: the Coach
# falls back to its built-in replies and the capture box keeps filing.

# AI_ENABLED: "auto" (default) turns the assistant on when a key exists,
# "true" forces it on, "false" keeps every message on the device.
AI_ENABLED="auto"

# Primary provider: Freebuff's OpenAI-compatible API.
FREEBUFF_API_KEY=""
# Freebuff model id (or a comma-separated list for a primary and backup).
# Model ids change, so this is required: check the ids your Freebuff plan serves.
FREEBUFF_MODEL=""
# FREEBUFF_MODELS="model-one,model-two"
# Optional prices per 1M tokens, used only for the cost estimate.
FREEBUFF_INPUT_PRICE_PER_MILLION=""
FREEBUFF_OUTPUT_PRICE_PER_MILLION=""

# Secondary provider: OpenAI, used as the fallback.
OPENAI_API_KEY=""

# Optional third provider: Hugging Face Inference Providers. Needs both a token
# and an explicit model, because available models change and the router will
# otherwise fan out to vendors whose terms exclude under-18 users.
HUGGINGFACE_API_KEY=""
HF_MODEL=""
# HF_PROVIDER is pinned and must be one of: together, cerebras, deepinfra,
# cohere, hf-inference. Anything else is ignored.
HF_PROVIDER="together"
# Prices vary by upstream provider. Set these per 1M tokens for budgeting.
HF_INPUT_PRICE_PER_MILLION=""
HF_OUTPUT_PRICE_PER_MILLION=""

# Model routing as "provider:model". Defaults: freebuff:<FREEBUFF_MODEL> with
# another enabled model as the backup, or openai:gpt-6-luna when only OpenAI
# has a key.
AI_DEFAULT_MODEL=""
AI_BACKUP_MODEL=""

# Response settings.
AI_TEMPERATURE="0.6"
AI_MAX_OUTPUT_TOKENS="700"
AI_TIMEOUT_MS="25000"
AI_HISTORY_LIMIT="12"
AI_MAX_MESSAGE_CHARS="4000"

# Usage and spending limits, enforced server-side from data/ai-usage.json.
AI_REQUESTS_PER_DAY="300"
AI_TOKENS_PER_DAY="400000"
AI_COST_PER_MONTH_USD="10"
AI_REQUESTS_PER_MINUTE="12"

# OpenAI reasoning effort: none, low, medium, high.
OPENAI_REASONING_EFFORT="low"

# --------------------------------------------------- provider selection
# Change these to switch provider without touching feature code.
AI_PROVIDER_ORDER="freebuff,openai,huggingface"
AI_DEFAULT_MODEL=""          # e.g. freebuff:your-model-id
AI_BACKUP_PROVIDER=""        # e.g. openai
AI_BACKUP_MODEL=""           # e.g. openai:gpt-6-luna
# Comma separated "provider:model" entries to switch off.
AI_DISABLED_MODELS=""

# OpenAI is paid and stays off until you opt in explicitly.
OPENAI_ENABLED="false"
FREEBUFF_ENABLED="true"
HUGGINGFACE_ENABLED="true"

# Per-provider daily ceilings and output ceilings.
FREEBUFF_DAILY_REQUESTS="1000"
FREEBUFF_MAX_OUTPUT_TOKENS="700"
OPENAI_DAILY_REQUESTS="200"
OPENAI_MAX_OUTPUT_TOKENS="700"
HUGGINGFACE_DAILY_REQUESTS="200"
HUGGINGFACE_MAX_OUTPUT_TOKENS="700"

# Base URL overrides, useful for a proxy or a local test double.
FREEBUFF_BASE_URL=""
OPENAI_BASE_URL=""
HUGGINGFACE_BASE_URL=""

# Streaming and live model validation.
AI_STREAMING="true"
# When true, the configured models are checked against the provider's live model
# list before a request, so a withdrawn model fails loudly instead of silently.
AI_VALIDATE_MODELS="false"

# Legacy per-client daily ceiling. Authenticated calls are keyed by the verified
# account id, so a browser header cannot rotate this quota.
AI_REQUESTS_PER_DAY_PER_CLIENT="80"

# ------------------------------------------------- per-user limits and caching
# Per verified account. These sit on top of the global limits above.
AI_REQUESTS_PER_DAY_PER_USER="60"
AI_TOKENS_PER_DAY_PER_USER="60000"
AI_COST_PER_MONTH_PER_USER_USD="2"

# Conversation and memory caps. Lower them to cut cost per request.
AI_HISTORY_CHARS="8000"
AI_MEMORY_LIMIT="12"
AI_MAX_REPLY_CHARS="4000"

# Short-lived reply cache. Identical questions with identical context cost
# nothing while the entry is fresh. Set AI_CACHE_ENABLED=false to turn it off.
AI_CACHE_ENABLED="true"
AI_CACHE_TTL_SECONDS="900"
AI_CACHE_MAX_ENTRIES="250"

# TEMPORARY break-glass credential for /admin/ai (server only). Prefer a
# Supabase account listed in public.admin_users. Remove this token once every
# operator has that trusted row. Use a long random value while it exists:
#   openssl rand -hex 24
# Compared in constant time, never sent to the browser and never stored in the app.
AI_ADMIN_TOKEN=

# ------------------------------------------------------------ RevenueCat billing
# Sandbox only by default. Leave these blank until sandbox testing is ready;
# no live payment credential belongs in this project.
# REVENUECAT_ENVIRONMENT is SANDBOX unless set to PRODUCTION.
REVENUECAT_ENVIRONMENT="SANDBOX"
# Keep this false. The app never starts a live checkout from this build.
REVENUECAT_LIVE_PAYMENTS="false"
# Public Web Billing SDK key. This is intentionally browser-visible; use the
# test_ key while the app is in sandbox. Never put the secret key here.
VITE_REVENUECAT_WEB_API_KEY=""
# RevenueCat entitlement that maps to the server's Plus plan.
REVENUECAT_PLUS_ENTITLEMENT="pb_j_pro"
# Product identifiers configured in RevenueCat. The dashboard offering maps
# these to packages named monthly, yearly and lifetime.
REVENUECAT_PRODUCT_PLUS_MONTHLY="monthly"
REVENUECAT_PRODUCT_PLUS_ANNUAL="yearly"
REVENUECAT_PRODUCT_PLUS_LIFETIME="lifetime"
# Optional extra product ids, comma separated.
REVENUECAT_PLUS_PRODUCTS=""
# Server-only sandbox secret key, used to re-verify a customer. Never expose it.
REVENUECAT_SECRET_KEY=""
# The Authorization value configured on the RevenueCat webhook. Long and random.
REVENUECAT_WEBHOOK_AUTH=""
# Override only for a local test double.
REVENUECAT_API_BASE="https://api.revenuecat.com/v1"

# Daily spend ceiling across all providers, in US dollars.
AI_COST_PER_DAY_USD=2
