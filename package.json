{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "overrides": {
    "node-domexception": "file:./node-domexception-shim"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && node -e \"require('fs').copyFileSync('dist/index.html', 'dist/404.html')\" && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "ai:check": "tsx scripts/ai-check.ts",
    "ai:models": "tsx scripts/ai-check.ts --models",
    "ai:test": "tsx tests/ai-system.test.ts",
    "ai:admin:test": "tsx tests/ai-admin.test.ts",
    "ai:admin:models:test": "tsx tests/ai-admin-models.test.ts",
    "ai:admin:spending:test": "tsx tests/ai-spending-safety.test.ts",
    "ai:admin:supabase:test": "tsx tests/ai-admin-supabase.test.ts",
    "ai:admin:analytics:test": "tsx tests/ai-admin-analytics.test.ts",
    "ai:admin:credit:test": "tsx tests/ai-admin-credit-management.test.ts",
    "ai:credits:test": "tsx tests/ai-credits.test.ts",
    "ai:audit:test": "tsx tests/ai-audit.test.ts",
    "ai:subscriptions:test": "tsx tests/ai-subscriptions.test.ts",
    "ai:usage:test": "tsx tests/ai-usage-analytics.test.ts",
    "billing:test": "tsx tests/billing-revenuecat.test.ts",
    "auth:test": "tsx tests/auth.test.ts",
    "auth:supabase:test": "tsx tests/auth-supabase.test.ts",
    "security:test": "tsx tests/security-admin.test.ts && tsx tests/security-rls.test.ts",
    "supabase:connection": "tsx scripts/supabase-connection.ts",
    "supabase:migrate-credits": "tsx scripts/migrate-legacy-credits.ts",
    "supabase:test": "tsx tests/supabase-foundation.test.ts",
    "supabase:phase5:test": "tsx tests/supabase-phase5.test.ts",
    "credits:migration:test": "tsx tests/legacy-credit-migration.test.ts",
    "supabase:concurrency:test": "tsx tests/supabase-concurrency.test.ts",
    "supabase:concurrency:local": "node scripts/supabase-local-concurrency.mjs",
    "ai:admin:monitoring:test": "tsx tests/ai-activity-monitoring.test.ts"
  },
  "dependencies": {
    "@revenuecat/purchases-js": "^1.74.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "express": "^4.21.2",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.2",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.15.5",
    "embedded-postgres": "^18.6.0-beta.19",
    "esbuild": "^0.28.0",
    "pg": "^8.16.3",
    "supabase": "^3.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
